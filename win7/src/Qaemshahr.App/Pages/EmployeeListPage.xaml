<Page x:Class="Qaemshahr.App.Pages.EmployeeListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      FlowDirection="RightToLeft" Background="{StaticResource BgBrush}">
  <DockPanel Margin="20">
    <TextBlock DockPanel.Dock="Top" Text="مدیریت کارکنان" Style="{StaticResource PageTitle}"/>
    <Border x:Name="FilterBanner" DockPanel.Dock="Top" Style="{StaticResource SoftPanel}"
            Padding="12,8" Margin="0,0,0,10" Visibility="Collapsed">
      <DockPanel LastChildFill="True">
        <Button DockPanel.Dock="Left" Content="حذف فیلتر" Style="{StaticResource GhostButton}"
                Padding="10,4" MinHeight="30" FontSize="12" Click="OnClearDashboardFilter" Margin="8,0,0,0"/>
        <TextBlock x:Name="FilterBannerText" VerticalAlignment="Center" TextWrapping="Wrap"/>
      </DockPanel>
    </Border>
    <WrapPanel DockPanel.Dock="Top" Style="{StaticResource Toolbar}" Margin="0,0,0,12">
      <Button x:Name="NewButton" Content="کارمند جدید" Style="{StaticResource PrimaryButton}" Click="OnNew"/>
      <Button x:Name="ImportButton" Content="ورود گروهی" Style="{StaticResource GhostButton}" Click="OnImport"/>
      <Button x:Name="ExportButton" Content="خروجی اکسل" Style="{StaticResource GhostButton}" Click="OnExport"/>
      <Button Content="ویرایش" Style="{StaticResource GhostButton}" Click="OnEdit"/>
      <Button Content="حذف" Style="{StaticResource DangerButton}" Click="OnDelete"/>
    </WrapPanel>
    <TextBox x:Name="SearchBox" DockPanel.Dock="Top" TextChanged="OnSearch" Margin="0,0,0,10"
             ToolTip="جستجوی نام، کد ملی یا تلفن"/>
    <TextBlock x:Name="EmptyText" DockPanel.Dock="Top" Style="{StaticResource MutedText}"
               Text="کارمندی ثبت نشده است." Visibility="Collapsed" Margin="0,0,0,8"/>
    <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" LastChildFill="False">
      <Button x:Name="PrevPeoplePage" Content="صفحه قبل" Style="{StaticResource ChipButton}"
              Click="OnPrevPeoplePage" MinHeight="34" Margin="0,0,10,0" IsEnabled="False"/>
      <TextBlock x:Name="PeoplePageInfo" Style="{StaticResource MutedText}" VerticalAlignment="Center"
                 Margin="0,0,10,0" Text="صفحه ۱"/>
      <Button x:Name="NextPeoplePage" Content="صفحه بعد" Style="{StaticResource ChipButton}"
              Click="OnNextPeoplePage" MinHeight="34" IsEnabled="False"/>
    </DockPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <WrapPanel x:Name="CardsHost"/>
    </ScrollViewer>
  </DockPanel>
</Page>
