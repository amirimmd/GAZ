<Page x:Class="Qaemshahr.App.Pages.SearchPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      FlowDirection="RightToLeft" Background="{StaticResource BgBrush}">
  <DockPanel Margin="20">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="جستجوی پیشرفته" Style="{StaticResource PageTitle}"/>
      <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,10" TextWrapping="Wrap"
                 Text="جستجو روی نام، کد ملی، شماره پرسنلی، تلفن و سمت است. کلمات ساده همگی لازم‌اند؛ برای «یا» از OR و برای حذف از NOT استفاده کنید."/>
      <WrapPanel Style="{StaticResource Toolbar}" Margin="0,0,0,12">
        <Button Content="جستجو" Style="{StaticResource PrimaryButton}" Click="OnSearch"/>
        <Button Content="OR" Style="{StaticResource GhostButton}" Click="OnOr"/>
        <Button Content="NOT" Style="{StaticResource GhostButton}" Click="OnNot"/>
        <Button Content="ساخت گروه از نتایج" Style="{StaticResource GhostButton}" Click="OnGroup"/>
      </WrapPanel>
      <TextBox x:Name="QueryBox" KeyDown="OnKey" Margin="0,0,0,8"
               FlowDirection="RightToLeft" TextAlignment="Left"
               HorizontalContentAlignment="Left"
               ToolTip="نام فارسی راست‌چین؛ کد ملی و انگلیسی چپ‌چین"/>
      <TextBlock x:Name="CountText" Margin="0,0,0,8"/>
    </StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel x:Name="ResultsHost"/>
    </ScrollViewer>
  </DockPanel>
</Page>
