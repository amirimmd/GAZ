<Window x:Class="Qaemshahr.App.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ورود به سامانه"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Language="fa-IR"
        FlowDirection="LeftToRight"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource AppFont}"
        Icon="/Qaemshahr;component/Assets/app.ico">
  <Border Margin="18" Background="{StaticResource SurfaceBrush}"
          BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
          CornerRadius="14" Padding="26,24" FlowDirection="RightToLeft">
    <StackPanel>
      <Border Background="{StaticResource SoftPanelBrush}" CornerRadius="12" Width="64" Height="64"
              Padding="6" HorizontalAlignment="Center"
              BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Image Source="/Qaemshahr;component/Assets/organization_logo.png" Stretch="Uniform"
               RenderOptions.BitmapScalingMode="HighQuality"/>
      </Border>
      <TextBlock Text="سامانه منابع انسانی قائم‌شهر"
                 Foreground="{StaticResource PrimaryBrush}" FontSize="17" FontWeight="Bold"
                 HorizontalAlignment="Center" TextAlignment="Center" Margin="8,14,8,4" TextWrapping="Wrap"/>
      <TextBlock Text="ورود به سامانه" Style="{StaticResource MutedText}"
                 HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,20"/>

      <TextBlock Style="{StaticResource FieldLabel}" Text="نام کاربری"/>
      <TextBox x:Name="UserBox" Style="{StaticResource LtrBox}" Margin="0,0,0,12"/>

      <TextBlock Style="{StaticResource FieldLabel}" Text="رمز عبور"/>
      <Grid FlowDirection="LeftToRight" Margin="0,0,0,10">
        <PasswordBox x:Name="PasswordBox" Padding="10,8,42,8" KeyDown="OnCredentialKey"/>
        <TextBox x:Name="PasswordPlainBox" Style="{StaticResource LtrBox}" Padding="10,8,42,8"
                 Visibility="Collapsed" KeyDown="OnCredentialKey"/>
        <ToggleButton x:Name="ShowPassToggle" Width="34" Height="34" Margin="0,0,6,0"
                      HorizontalAlignment="Right" VerticalAlignment="Center"
                      Background="Transparent" BorderThickness="0" Cursor="Hand"
                      ToolTip="نمایش / مخفی کردن رمز"
                      Checked="OnTogglePassword" Unchecked="OnTogglePassword"
                      Focusable="False">
          <Viewbox Width="18" Height="18">
            <Path x:Name="EyePath" Fill="{StaticResource MutedBrush}" Stretch="Uniform"
                  Data="M12,4.5C7,4.5 2.73,7.61 1,12C2.73,16.39 7,19.5 12,19.5C17,19.5 21.27,16.39 23,12C21.27,7.61 17,4.5 12,4.5M12,17A5,5 0 0,1 7,12A5,5 0 0,1 12,7A5,5 0 0,1 17,12A5,5 0 0,1 12,17M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9Z"/>
          </Viewbox>
        </ToggleButton>
      </Grid>

      <CheckBox x:Name="RememberPassBox" Content="به‌خاطر سپردن رمز عبور" Margin="0,0,0,12"/>

      <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                 MinHeight="18" FontSize="12" TextAlignment="Center" HorizontalAlignment="Stretch"/>

      <Button Content="ورود به سامانه" Style="{StaticResource PrimaryButton}" Click="OnLogin"
              HorizontalAlignment="Stretch" Margin="0,8,0,0"/>
      <Button Content="فراموشی رمز عبور" Style="{StaticResource GhostButton}" Click="OnForgot"
              HorizontalAlignment="Stretch" Margin="0,8,0,0"/>
      <TextBlock x:Name="VersionText" Style="{StaticResource MutedText}" FontSize="11"
                 HorizontalAlignment="Center" TextAlignment="Center" Margin="0,16,0,0"/>
    </StackPanel>
  </Border>
</Window>
