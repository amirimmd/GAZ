<Page x:Class="Qaemshahr.App.Pages.ReportsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ctrl="clr-namespace:Qaemshahr.App.Controls"
      FlowDirection="RightToLeft" Background="{StaticResource BgBrush}">
  <Page.Resources>
    <Style x:Key="ExcelButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
      <Setter Property="Foreground" Value="{StaticResource SuccessTextBrush}"/>
      <Setter Property="BorderBrush" Value="#81C784"/>
      <Setter Property="MinWidth" Value="132"/>
      <Setter Property="Margin" Value="0,0,0,0"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}"/>
          <Setter Property="BorderBrush" Value="{StaticResource SuccessTextBrush}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="PdfButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
      <Setter Property="MinWidth" Value="132"/>
      <Setter Property="Margin" Value="0,0,10,0"/>
    </Style>
    <Style x:Key="ReportChip" TargetType="Button" BasedOn="{StaticResource ChipButton}">
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="MinWidth" Value="88"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Padding" Value="12,4"/>
    </Style>
    <Style x:Key="InlineCheck" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="Margin" Value="0,0,16,0"/>
      <Setter Property="MinWidth" Value="120"/>
    </Style>
  </Page.Resources>

  <Grid>
  <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                Padding="0" CanContentScroll="False">
  <Grid Margin="16,12,16,12" MinWidth="900">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" CornerRadius="14" Padding="18,14" Margin="0,0,0,10"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
      <Border.Background>
        <LinearGradientBrush StartPoint="1,0" EndPoint="0,1">
          <GradientStop Color="#E7F2F8" Offset="0"/>
          <GradientStop Color="#FFFFFF" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="سازنده گزارش" FontSize="22" FontWeight="Bold"
                     Foreground="{StaticResource PrimaryBrush}"/>
          <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0" TextWrapping="Wrap"
                     Text="چیدمان، فیلتر سرستونی و خروجی PDF یا اکسل — همه در یک صفحه."/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="PdfExportButton" Content="خروجی PDF" Style="{StaticResource PdfButton}" Click="OnPdf"/>
          <Button x:Name="ExcelExportButton" Content="خروجی اکسل" Style="{StaticResource ExcelButton}" Click="OnExcel"/>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.4*" MinWidth="280"/>
        <ColumnDefinition Width="10"/>
        <ColumnDefinition Width="*" MinWidth="240"/>
      </Grid.ColumnDefinitions>

      <Border Style="{StaticResource CardFill}" Padding="14">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="مشخصات خروجی" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="10"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="10"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Style="{StaticResource FieldLabel}" Text="عنوان گزارش" Margin="0,0,0,4"/>
              <TextBox x:Name="TitleBox" Text="گزارش کارکنان"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Style="{StaticResource FieldLabel}" Text="سربرگ" Margin="0,0,0,4"/>
              <TextBox x:Name="HeaderBox"/>
            </StackPanel>
            <StackPanel Grid.Column="4">
              <TextBlock Style="{StaticResource FieldLabel}" Text="پاورقی" Margin="0,0,0,4"/>
              <TextBox x:Name="FooterBox"/>
            </StackPanel>
          </Grid>
          <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="16"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="16"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <CheckBox x:Name="LogoBox" Content="لوگو در سربرگ" IsChecked="True" Style="{StaticResource InlineCheck}"/>
              <CheckBox x:Name="PageNumBox" Content="شماره صفحه" IsChecked="True" Style="{StaticResource InlineCheck}" Margin="0"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Style="{StaticResource FieldLabel}" Text="واترمارک" Margin="0,0,0,4"/>
              <WrapPanel>
                <Button x:Name="WaterNoneButton" Content="بدون واترمارک" Style="{StaticResource ChipButtonSelected}"
                        Click="OnWatermark" Tag="none"/>
                <Button x:Name="WaterLogoButton" Content="لوگو" Style="{StaticResource ChipButton}"
                        Click="OnWatermark" Tag="logo"/>
                <Button x:Name="WaterTextButton" Content="متنی" Style="{StaticResource ChipButton}"
                        Click="OnWatermark" Tag="text"/>
              </WrapPanel>
              <TextBox x:Name="WatermarkBox" Margin="0,6,0,0" Visibility="Collapsed"/>
            </StackPanel>
            <StackPanel Grid.Column="4">
              <TextBlock Style="{StaticResource FieldLabel}" Text="جهت صفحه" Margin="0,0,0,4"/>
              <WrapPanel>
                <Button x:Name="OrientAutoButton" Content="خودکار" Style="{StaticResource ChipButtonSelected}"
                        Click="OnOrientation" Tag="auto"/>
                <Button x:Name="OrientPortButton" Content="عمودی" Style="{StaticResource ChipButton}"
                        Click="OnOrientation" Tag="portrait"/>
                <Button x:Name="OrientLandButton" Content="افقی" Style="{StaticResource ChipButton}"
                        Click="OnOrientation" Tag="landscape"/>
              </WrapPanel>
            </StackPanel>
          </Grid>
          <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock Style="{StaticResource FieldLabel}" Text="تاریخ گزارش" Margin="0,0,0,4"/>
            <ctrl:ShamsiDateField x:Name="ReportDateField" HorizontalAlignment="Stretch"/>
          </StackPanel>
          <Grid Grid.Row="4" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="16"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <CheckBox x:Name="SignatureBox" Content="محل امضا در انتهای خروجی"
                      Style="{StaticResource InlineCheck}" Margin="0" VerticalAlignment="Center"
                      Checked="OnSignatureToggle" Unchecked="OnSignatureToggle"/>
            <StackPanel Grid.Column="2">
              <TextBlock Style="{StaticResource FieldLabel}" Text="عنوان زیر امضا" Margin="0,0,0,4"/>
              <TextBox x:Name="SignatureTitleBox" Text="مدیر منابع انسانی" IsEnabled="False"/>
            </StackPanel>
          </Grid>
        </Grid>
      </Border>

      <Border Grid.Column="2" Style="{StaticResource CardFill}" Padding="14">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="56"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="چیدمان‌ها" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap"
                       Text="پیش‌فرض همیشه هست. با + چیدمان بسازید؛ راست‌کلیک حذف می‌کند."/>
          </StackPanel>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled" Padding="0,0,0,4">
            <WrapPanel x:Name="LayoutButtonsHost" Orientation="Horizontal"/>
          </ScrollViewer>
          <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="8"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="8"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="ذخیره چیدمان" Style="{StaticResource GhostButton}"
                    Click="OnSaveLayout" MinHeight="34" HorizontalAlignment="Stretch" Padding="8,6"/>
            <Button Grid.Column="2" Content="ستون‌های خروجی" Style="{StaticResource ChipButton}"
                    Click="OnEditColumns" MinHeight="34" HorizontalAlignment="Stretch" Margin="0"
                    Padding="8,6"/>
            <Button Grid.Column="4" Content="بازنشانی فیلترها" Style="{StaticResource ChipButton}"
                    Click="OnResetFilters" MinHeight="34" HorizontalAlignment="Stretch" Margin="0"
                    Padding="8,6"/>
          </Grid>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="2" Style="{StaticResource CardFill}" Padding="12">
      <DockPanel LastChildFill="True">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="فیلتر و نتایج" Style="{StaticResource SectionTitle}" Margin="0,0,0,2"/>
            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap"
                       Text="همه ستون‌ها قابل فیلترند. حاشیه سبز = در خروجی چیدمان، قرمز = فقط فیلتر. با دکمه‌های « » ترتیب را جابه‌جا کنید. فقط ردیف‌های تیک‌خورده خروجی می‌گیرند."/>
          </StackPanel>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left">
            <TextBlock x:Name="MatchCountText" Style="{StaticResource MutedText}" HorizontalAlignment="Left"/>
            <TextBlock x:Name="ExportCountText" Style="{StaticResource MutedText}" HorizontalAlignment="Left" Margin="0,2,0,0"/>
          </StackPanel>
        </Grid>

        <Expander x:Name="GroupFilterExpander" DockPanel.Dock="Top" Margin="0,0,0,10"
                  Header="خروجی بر اساس گروه" Expanded="OnGroupFilterExpand">
          <Border Style="{StaticResource CardFill}" Padding="12" Margin="0,8,0,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Style="{StaticResource FieldLabel}" Text="گروه" Margin="0,0,0,4"/>
                <ComboBox x:Name="GroupFilterBox" SelectionChanged="OnGroupFilterChanged"/>
                <TextBlock x:Name="GroupFilterHint" Style="{StaticResource MutedText}" Margin="0,6,0,0"
                           TextWrapping="Wrap"
                           Text="با انتخاب گروه، فقط اعضای همان گروه برای خروجی می‌آیند و فیلترهای دیگر اعمال نمی‌شوند."/>
              </StackPanel>
              <Button Grid.Column="2" Content="پاک کردن گروه" Style="{StaticResource ChipButton}"
                      VerticalAlignment="Bottom" Click="OnClearGroupFilter" MinHeight="34"/>
            </Grid>
          </Border>
        </Expander>

        <Grid DockPanel.Dock="Top" Margin="0,0,0,8" x:Name="ClassicFilterBar">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.4*" MinWidth="160"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="*" MinWidth="140"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <DockPanel LastChildFill="True">
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource FieldLabel}" Text="جستجوی سریع" Margin="0,0,0,4"/>
            <TextBox x:Name="SearchBox" TextChanged="OnFilterChanged"/>
          </DockPanel>
          <DockPanel Grid.Column="2" LastChildFill="True">
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource FieldLabel}" Text="مرتب‌سازی" Margin="0,0,0,4"/>
            <ComboBox x:Name="SortByBox" SelectionChanged="OnFilterChanged"/>
          </DockPanel>
          <DockPanel Grid.Column="4" LastChildFill="True" MinWidth="120">
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource FieldLabel}" Text="جهت" Margin="0,0,0,4"/>
            <ComboBox x:Name="SortDirBox" SelectionChanged="OnFilterChanged"/>
          </DockPanel>
          <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Bottom">
            <Button Content="انتخاب همه" Style="{StaticResource ChipButton}" Click="OnSelectAllMatches" Margin="0,0,8,0"/>
            <Button Content="برداشتن تیک‌ها" Style="{StaticResource ChipButton}" Click="OnClearAllMatches" Margin="0"/>
          </StackPanel>
        </Grid>

        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0" LastChildFill="True">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="PrevPageButton" Content="صفحه قبل" Style="{StaticResource ChipButton}"
                    Click="OnPrevResultPage" MinHeight="34" Margin="0,0,10,0" IsEnabled="False"/>
            <TextBlock x:Name="PageInfoText" Style="{StaticResource MutedText}"
                       VerticalAlignment="Center" Margin="0,0,10,0"
                       Text="صفحه ۱ از ۱"/>
            <Button x:Name="NextPageButton" Content="صفحه بعد" Style="{StaticResource ChipButton}"
                    Click="OnNextResultPage" MinHeight="34" IsEnabled="False"/>
          </StackPanel>
        </DockPanel>

        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="8" ClipToBounds="False"
                MinHeight="420" Height="520">
          <ScrollViewer x:Name="ResultScroll" HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Auto"
                        FlowDirection="RightToLeft" Padding="0"
                        CanContentScroll="False"
                        PreviewMouseWheel="OnResultScrollWheel">
            <Grid x:Name="ResultTableHost" FlowDirection="RightToLeft" SnapsToDevicePixels="True"
                  ClipToBounds="False"/>
          </ScrollViewer>
        </Border>
      </DockPanel>
    </Border>
  </Grid>
  </ScrollViewer>

  <!-- پوشش آماده‌سازی خروجی — UI را زنده نگه می‌دارد -->
  <Border x:Name="ExportBusyOverlay" Visibility="Collapsed" Background="#990B4A6F"
          Panel.ZIndex="200" IsHitTestVisible="True">
    <Border Width="420" MaxWidth="520" Padding="28,24" CornerRadius="14"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            Effect="{x:Null}">
      <StackPanel>
        <TextBlock Text="در حال آماده‌سازی خروجی"
                   FontSize="20" FontWeight="Bold"
                   Foreground="{StaticResource PrimaryBrush}"
                   HorizontalAlignment="Center" TextAlignment="Center"/>
        <TextBlock x:Name="ExportBusyDetail"
                   Text="لطفاً صبر کنید؛ برنامه در حال ساخت فایل است."
                   Style="{StaticResource MutedText}" Margin="0,10,0,18"
                   TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center"/>
        <ProgressBar x:Name="ExportBusyBar" Height="10" IsIndeterminate="True"
                     Minimum="0" Maximum="100"/>
        <TextBlock x:Name="ExportBusyHint"
                   Text="با حجم زیاد داده ممکن است چند دقیقه طول بکشد."
                   Style="{StaticResource MutedText}" Margin="0,14,0,0"
                   FontSize="12" TextAlignment="Center" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>
  </Border>
  </Grid>
</Page>
