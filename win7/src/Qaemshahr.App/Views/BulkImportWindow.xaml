<Window x:Class="Qaemshahr.App.Views.BulkImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ورود گروهی" Height="740" Width="1080"
        WindowStartupLocation="CenterOwner" FlowDirection="LeftToRight"
        Background="{StaticResource BgBrush}" FontFamily="{StaticResource AppFont}">
  <DockPanel FlowDirection="RightToLeft">
    <Border DockPanel.Dock="Bottom" Padding="16,12" Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
      <StackPanel>
        <TextBlock x:Name="StatusText" Style="{StaticResource MutedText}" Margin="0,0,0,10"
                   TextWrapping="Wrap"/>
        <WrapPanel>
          <Button x:Name="BackButton" Content="بازگشت" Style="{StaticResource GhostButton}"
                  Click="OnBack" Visibility="Collapsed"/>
          <Button Content="انصراف" Style="{StaticResource GhostButton}" IsCancel="True" Click="OnCancel"/>
          <Button x:Name="NextButton" Content="ادامه به ورود" Style="{StaticResource PrimaryButton}" Click="OnNext"/>
          <Button x:Name="CommitButton" Content="ثبت همه" Style="{StaticResource PrimaryButton}"
                  Click="OnCommit" Visibility="Collapsed"/>
        </WrapPanel>
      </StackPanel>
    </Border>

    <ScrollViewer x:Name="SettingsPanel" Margin="20" VerticalScrollBarVisibility="Auto">
      <StackPanel MaxWidth="780" HorizontalAlignment="Stretch">
        <TextBlock Text="تنظیمات ورود گروهی" Style="{StaticResource PageTitle}"/>
        <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,14" TextWrapping="Wrap"
                   Text="با منوی جمع‌شونده، فیلدهای هر بخش را انتخاب کنید. در مرحله بعد روی هر کارت می‌توانید عکس و اسناد (شناسنامه، کارت ملی، سایر) را مثل پرونده کارمند اضافه کنید."/>
        <WrapPanel Margin="0,0,0,10">
          <Button Content="همه فیلدها" Style="{StaticResource ChipButton}" Click="OnSelectAllFields"/>
          <Button Content="فقط الزامی" Style="{StaticResource ChipButton}" Click="OnSelectRequiredFields"/>
          <Button Content="پیش‌فرض" Style="{StaticResource ChipButton}" Click="OnSelectDefaultFields"/>
        </WrapPanel>
        <StackPanel x:Name="SectionsHost"/>
        <Border Style="{StaticResource Card}" Margin="0,8,0,0" HorizontalAlignment="Stretch">
          <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap"
                     Text="قالب اکسل فقط فیلدهای متنی را پوشش می‌دهد؛ اسناد و عکس را روی کارت‌ها بارگذاری کنید."/>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <DockPanel x:Name="EntryPanel" Margin="16" Visibility="Collapsed">
      <TextBlock DockPanel.Dock="Top" Text="ورود کارکنان" Style="{StaticResource PageTitle}" Margin="4,0,4,4"/>
      <TextBlock x:Name="SectionsSummary" DockPanel.Dock="Top" Style="{StaticResource MutedText}"
                 Margin="4,0,4,8" TextWrapping="Wrap"/>
      <Expander x:Name="FieldsExpander" DockPanel.Dock="Top" Header="ویرایش فیلدهای انتخاب‌شده"
                Margin="0,0,0,10" IsExpanded="False" Expanded="OnFieldsExpanded">
        <Border Style="{StaticResource Card}" Margin="0,8,0,0" Padding="12" HorizontalAlignment="Stretch">
          <StackPanel x:Name="EntryFieldsHost"/>
        </Border>
      </Expander>
      <WrapPanel DockPanel.Dock="Top" Style="{StaticResource Toolbar}" Margin="0,0,0,12">
        <Button Content="دانلود قالب اکسل" Style="{StaticResource GhostButton}" Click="OnTemplate"/>
        <Button Content="انتخاب فایل اکسل" Style="{StaticResource PrimaryButton}" Click="OnPick"/>
        <Button Content="افزودن کارت" Style="{StaticResource GhostButton}" Click="OnAddCard"/>
        <Button Content="پاک‌کردن کارت‌ها" Style="{StaticResource DangerButton}" Click="OnClearCards"/>
      </WrapPanel>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <WrapPanel x:Name="CardsHost"/>
      </ScrollViewer>
    </DockPanel>
  </DockPanel>
</Window>
