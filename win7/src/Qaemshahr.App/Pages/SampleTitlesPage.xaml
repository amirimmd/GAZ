<Page x:Class="Qaemshahr.App.Pages.SampleTitlesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      FlowDirection="RightToLeft" Background="{StaticResource BgBrush}">
  <DockPanel Margin="16,12,16,8">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
      <TextBlock Text="عناوین نمونه" Style="{StaticResource PageTitle}"/>
      <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0" TextWrapping="Wrap"
                 Text="فرد را انتخاب کنید؛ نوع نمونه (کارمند/کارگر) از پرونده او مشخص می‌شود. برای هر نمونه می‌توانید گزارش بنویسید و ببینید."/>
    </StackPanel>

    <Border DockPanel.Dock="Top" Style="{StaticResource CardFill}" Padding="14" Margin="0,0,0,10">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="110"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Style="{StaticResource FieldLabel}" Text="سال"/>
            <ComboBox x:Name="YearBox" SelectionChanged="OnAddYearChanged"/>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Style="{StaticResource FieldLabel}" Text="انتخاب فرد"/>
            <ComboBox x:Name="PersonBox" IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True"
                      SelectionChanged="OnPersonSelectionChanged"/>
          </StackPanel>
        </Grid>

        <Border x:Name="PersonPreviewHost" Margin="0,10,0,0" Padding="10" CornerRadius="8"
                Background="{StaticResource SoftPanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" Visibility="Collapsed">
          <DockPanel LastChildFill="True">
            <Border x:Name="PersonPreviewPhoto" DockPanel.Dock="Right" Width="54" Height="72"
                    CornerRadius="4" ClipToBounds="True" Margin="12,0,0,0"
                    Background="{StaticResource FieldBgBrush}"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock x:Name="PersonPreviewName" FontWeight="SemiBold" FontSize="14"/>
              <TextBlock x:Name="PersonPreviewKind" FontWeight="SemiBold" FontSize="12"
                         Foreground="{StaticResource PrimaryBrush}" Margin="0,4,0,0"/>
              <TextBlock x:Name="PersonPreviewNationalId" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
              <TextBlock x:Name="PersonPreviewPosition" Style="{StaticResource MutedText}" Margin="0,2,0,0"
                         TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </DockPanel>
        </Border>

        <Grid Margin="0,10,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Style="{StaticResource FieldLabel}" Text="گزارش نمونه"/>
            <TextBox x:Name="NoteBox" MinHeight="56"
                     FlowDirection="RightToLeft"
                     TextAlignment="Left"
                     HorizontalContentAlignment="Left"
                     VerticalContentAlignment="Top"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"/>
          </StackPanel>
          <Button Grid.Column="2" Content="ثبت نمونه" Style="{StaticResource PrimaryButton}"
                  VerticalAlignment="Bottom" Click="OnAdd" MinHeight="34" MinWidth="110" Padding="16,6"/>
        </Grid>

        <TextBlock x:Name="PersonHintText" Style="{StaticResource MutedText}" FontSize="11"
                   Margin="0,6,0,0" TextWrapping="Wrap"
                   Text="نوع نمونه از روی کارمند/کارگر بودن فرد تعیین می‌شود. متن گزارش همراه با ثبت ذخیره می‌شود."/>

        <DockPanel Margin="0,10,0,0" LastChildFill="False">
          <Button DockPanel.Dock="Right" Content="کپی از سال قبل" Style="{StaticResource GhostButton}"
                  Click="OnCopyPrevYear" Margin="0,0,0,0"/>
          <Button DockPanel.Dock="Right" Content="سال فرم" Style="{StaticResource ChipButton}"
                  Click="OnFocusCurrentYear" Margin="0,0,6,0"/>
          <Button DockPanel.Dock="Right" Content="همه سال‌ها" Style="{StaticResource ChipButton}"
                  Click="OnShowAllYears" Margin="0,0,6,0"/>
          <TextBox x:Name="SearchBox" DockPanel.Dock="Left" Width="200" VerticalAlignment="Center"
                   ToolTip="جستجو در نام، کد ملی یا سازمان"/>
        </DockPanel>
      </StackPanel>
    </Border>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel x:Name="YearsHost" HorizontalAlignment="Stretch"/>
    </ScrollViewer>
  </DockPanel>
</Page>
