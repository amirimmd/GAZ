<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Qaemshahr.App</RootNamespace>
    <AssemblyName>Qaemshahr</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Product>سامانه منابع انسانی قائم‌شهر</Product>
    <Company>ir.gaz.qaemshahr</Company>
    <AssemblyTitle>قائم‌شهر</AssemblyTitle>
    <Version>2.3.12</Version>
    <FileVersion>2.3.12.0</FileVersion>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <PlatformTarget>x86</PlatformTarget>
    <Prefer32Bit>true</Prefer32Bit>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <ContentSQLiteInteropFiles>true</ContentSQLiteInteropFiles>
    <CopySQLiteInteropFiles>true</CopySQLiteInteropFiles>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Qaemshahr.Core\Qaemshahr.Core.csproj" />
    <ProjectReference Include="..\Qaemshahr.Data\Qaemshahr.Data.csproj" />
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="4.7.1" />
    <PackageReference Include="System.Memory" Version="4.5.5" />
    <PackageReference Include="iTextSharp.LGPLv2.Core" Version="3.4.25" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\*" />
    <Resource Include="Assets\Fonts\*" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>
</Project>
