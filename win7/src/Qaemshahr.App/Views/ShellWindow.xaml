<Window x:Class="Qaemshahr.App.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="سامانه منابع انسانی قائم‌شهر"
        Height="760" Width="1180"
        MinHeight="640" MinWidth="880"
        WindowStartupLocation="CenterScreen"
        Language="fa-IR"
        FlowDirection="LeftToRight"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource AppFont}"
        Icon="/Qaemshahr;component/Assets/app.ico">
  <!-- FlowDirection پنجره LTR است تا دکمه‌های بستن/کوچک‌نمایی سمت راست استاندارد ویندوز بمانند -->
  <DockPanel FlowDirection="RightToLeft">
    <Border DockPanel.Dock="Top" Height="3" Background="{StaticResource ChromeLineBrush}"/>
    <Border DockPanel.Dock="Top" Background="{StaticResource ChromeBrush}" Padding="16,10"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource SoftPanelBrush}"
                  BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="3" Margin="0,0,10,0">
            <Image Source="/Qaemshahr;component/Assets/organization_logo.png" Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
          </Border>
          <TextBlock Text="سامانه منابع انسانی قائم‌شهر" Foreground="{StaticResource PrimaryBrush}" FontSize="16"
                     FontWeight="Bold" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock x:Name="UserLabel" Foreground="{StaticResource ChromeOnPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
          <Button x:Name="LogoutButton" Content="خروج" Click="OnLogout"
                  Style="{StaticResource AccentButton}" Padding="16,6" MinHeight="32"/>
        </StackPanel>
      </Grid>
    </Border>
    <Border x:Name="NavBorder" DockPanel.Dock="Left" Width="228" Background="{StaticResource ChromeBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
      <DockPanel>
        <Button x:Name="NavToggle" DockPanel.Dock="Top" Style="{StaticResource NavButton}"
                Click="OnToggleNav" ToolTip="جمع کردن منو" Margin="6,10,4,6"
                FlowDirection="LeftToRight" HorizontalContentAlignment="Stretch"
                Padding="8,10,4,10">
          <!-- اول آیکون (راست)، بعد متن — چسبیده به هم -->
          <DockPanel x:Name="NavToggleRow" LastChildFill="True" FlowDirection="LeftToRight">
            <Viewbox x:Name="NavToggleIconHost" DockPanel.Dock="Right" Width="20" Height="20"
                     FlowDirection="LeftToRight" VerticalAlignment="Center" Margin="8,0,0,0">
              <Path x:Name="NavTogglePath" Fill="{StaticResource PrimaryBrush}" Stretch="Uniform"
                    FlowDirection="LeftToRight"
                    Data="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z"/>
            </Viewbox>
            <TextBlock x:Name="NavToggleLabel" DockPanel.Dock="Right" Text="منو"
                       VerticalAlignment="Center" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold"
                       FlowDirection="RightToLeft" TextAlignment="Right"/>
            <Border x:Name="NavToggleFiller"/>
          </DockPanel>
        </Button>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="NavPanel" Margin="0,4,0,12"/>
        </ScrollViewer>
      </DockPanel>
    </Border>
    <Frame x:Name="ContentFrame" NavigationUIVisibility="Hidden" Background="{StaticResource BgBrush}"/>
  </DockPanel>
</Window>
