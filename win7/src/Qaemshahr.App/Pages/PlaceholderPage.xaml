<Page x:Class="Qaemshahr.App.Pages.PlaceholderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      FlowDirection="RightToLeft"
      Background="{StaticResource BgBrush}">
  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
    <TextBlock x:Name="TitleText" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"/>
    <TextBlock Text="این بخش در موج‌های بعدی فعال می‌شود. داده و حساب شما ذخیره شده است."
               Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0" HorizontalAlignment="Center"/>
  </StackPanel>
</Page>
