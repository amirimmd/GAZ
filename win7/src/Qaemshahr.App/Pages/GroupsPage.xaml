<Page x:Class="Qaemshahr.App.Pages.GroupsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      FlowDirection="RightToLeft" Background="{StaticResource BgBrush}"
      SizeChanged="OnPageSizeChanged">
  <Page.Resources>
    <Style x:Key="GroupMeta" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Margin" Value="0,0,14,0"/>
    </Style>
    <Style x:Key="StatusPill" TargetType="Border">
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="10,3"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
  </Page.Resources>

  <DockPanel Margin="16,12,16,12">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
      <TextBlock Text="گروه‌ها" Style="{StaticResource PageTitle}"/>
      <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0" TextWrapping="Wrap"
                 Text="هر کارت یک گروه است؛ اعضا، بازه زمانی و فعالیت‌ها را ببینید و فعالیت جدید ثبت کنید."/>
    </StackPanel>

    <WrapPanel DockPanel.Dock="Top" Style="{StaticResource Toolbar}" Margin="0,0,0,10">
      <Button Content="گروه جدید" Style="{StaticResource PrimaryButton}" Click="OnNew"/>
      <TextBox x:Name="SearchBox" Width="280" MinHeight="34" Margin="12,0,0,0"
               VerticalContentAlignment="Center" TextChanged="OnFilter"
               ToolTip="جستجوی نام یا توضیح گروه"/>
    </WrapPanel>

    <ScrollViewer x:Name="CardsScroll" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled" SizeChanged="OnPageSizeChanged">
      <ItemsControl x:Name="CardsHost">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="2"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource CardFill}" Margin="0,0,12,12" Padding="14"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
              <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top">
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="12"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="88" Height="64" CornerRadius="10"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            Background="{StaticResource SoftPanelBrush}" ClipToBounds="True">
                      <Grid>
                        <TextBlock Text="بدون عکس" FontSize="10"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedBrush}"
                                   Visibility="{Binding PhotoPlaceholderVisibility}"/>
                        <Image Source="{Binding PhotoImage}" Stretch="UniformToFill"
                               Visibility="{Binding PhotoVisibility}"/>
                      </Grid>
                    </Border>
                    <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="17" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}" TextWrapping="Wrap"
                               VerticalAlignment="Center" TextAlignment="Right"/>
                    <Border Grid.Column="3" Style="{StaticResource StatusPill}"
                            Background="{Binding StatusBrush}" VerticalAlignment="Top">
                      <TextBlock Text="{Binding StatusFa}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                  </Grid>

                  <WrapPanel Margin="0,0,0,8">
                    <TextBlock Style="{StaticResource GroupMeta}" Text="{Binding PurposeLine}"/>
                    <TextBlock Style="{StaticResource GroupMeta}" Text="{Binding MemberLine}"/>
                  </WrapPanel>
                  <WrapPanel Margin="0,0,0,8">
                    <TextBlock Style="{StaticResource GroupMeta}" Text="{Binding StartLine}"/>
                    <TextBlock Style="{StaticResource GroupMeta}" Text="{Binding EndLine}"/>
                  </WrapPanel>
                  <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}"
                             TextWrapping="Wrap" Margin="0,0,0,10" TextAlignment="Right"
                             Visibility="{Binding DescriptionVisibility}"/>

                  <TextBlock Text="فعالیت‌ها" FontWeight="SemiBold" Margin="0,0,0,6"
                             Foreground="{StaticResource PrimaryBrush}" TextAlignment="Right"/>
                  <Border Background="{StaticResource SoftPanelBrush}" CornerRadius="8" Padding="8"
                          BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" MaxHeight="140"
                          Margin="0,0,0,10" Visibility="{Binding ActivitiesPanelVisibility}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                      <ItemsControl ItemsSource="{Binding Activities}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Grid Margin="0,0,0,6">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                              </Grid.ColumnDefinitions>
                              <StackPanel>
                                <TextBlock Text="{Binding SummaryLine}" TextWrapping="Wrap" FontSize="12"
                                           TextAlignment="Right"/>
                                <TextBlock Text="{Binding Note}" Style="{StaticResource MutedText}" FontSize="11"
                                           TextWrapping="Wrap" TextAlignment="Right"
                                           Visibility="{Binding NoteVisibility}"/>
                              </StackPanel>
                              <Button Grid.Column="1" Content="حذف" Style="{StaticResource DangerButton}"
                                      Padding="8,2" MinHeight="26" FontSize="11" Margin="8,0,0,0"
                                      Tag="{Binding Id}" Click="OnDeleteActivity"
                                      VerticalAlignment="Top"/>
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                  </Border>
                  <TextBlock Text="{Binding EmptyActivitiesText}" Style="{StaticResource MutedText}"
                             Margin="0,0,0,8" TextAlignment="Right"
                             Visibility="{Binding EmptyActivitiesVisibility}"/>
                </StackPanel>

                <UniformGrid DockPanel.Dock="Bottom" Columns="2" Rows="2" Margin="0,10,0,0">
                  <Button Content="ثبت فعالیت" Style="{StaticResource PrimaryButton}"
                          Tag="{Binding Id}" Click="OnAddActivity"
                          Margin="0,0,6,6" Padding="10,6" MinHeight="34"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                  <Button Content="ویرایش" Style="{StaticResource GhostButton}"
                          Tag="{Binding Id}" Click="OnEdit"
                          Margin="0,0,0,6" Padding="10,6" MinHeight="34"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                  <Button Content="خروجی اکسل" Style="{StaticResource GhostButton}"
                          Tag="{Binding Id}" Click="OnExport"
                          Margin="0,0,6,0" Padding="10,6" MinHeight="34"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                  <Button Content="حذف گروه" Style="{StaticResource DangerButton}"
                          Tag="{Binding Id}" Click="OnDelete"
                          Margin="0" Padding="10,6" MinHeight="34"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                </UniformGrid>
              </DockPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</Page>
