<Window x:Class="Qaemshahr.App.Views.ReportLayoutEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="چیدمان گزارش" Height="640" Width="560"
        WindowStartupLocation="CenterOwner" FlowDirection="LeftToRight"
        Background="{StaticResource BgBrush}" FontFamily="{StaticResource AppFont}">
  <DockPanel Margin="16" FlowDirection="RightToLeft">
    <StackPanel DockPanel.Dock="Bottom" Style="{StaticResource DialogButtonBar}" Margin="0,16,0,0">
      <Button Content="انصراف" Style="{StaticResource GhostButton}" IsCancel="True" Click="OnCancel"/>
      <Button Content="ذخیره" Style="{StaticResource PrimaryButton}" Click="OnSave"/>
    </StackPanel>
    <DockPanel>
      <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
        <TextBlock Style="{StaticResource FieldLabel}" Text="نام دکمه چیدمان"/>
        <TextBox x:Name="NameBox" Margin="0,0,0,8"/>
        <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap"
                   Text="فقط ستون‌هایی را که باید در خروجی PDF/اکسل این چیدمان باشند انتخاب کنید. فیلتر و نتایج همیشه همهٔ ستون‌ها را نشان می‌دهد."/>
        <WrapPanel Margin="0,8,0,0">
          <Button Content="همه" Style="{StaticResource ChipButton}" Click="OnAll"/>
          <Button Content="هیچ‌کدام" Style="{StaticResource ChipButton}" Click="OnNone"/>
          <Button Content="پیش‌فرض" Style="{StaticResource ChipButton}" Click="OnDefault"/>
        </WrapPanel>
      </StackPanel>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="ColumnsHost"/>
      </ScrollViewer>
    </DockPanel>
  </DockPanel>
</Window>
