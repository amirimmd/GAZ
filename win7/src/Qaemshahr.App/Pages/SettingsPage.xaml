<Page x:Class="Qaemshahr.App.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      FlowDirection="RightToLeft" Background="{StaticResource BgBrush}">
  <DockPanel Margin="16">
    <TextBlock DockPanel.Dock="Top" Text="تنظیمات" Style="{StaticResource PageTitle}" Margin="4,0,4,8"/>
    <TabControl x:Name="RootTabs">
      <TabItem x:Name="GeneralTab" Header="عمومی">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="16" MaxWidth="560" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource FieldLabel}" Text="نام سازمان"/>
            <TextBox x:Name="OrgBox" Margin="0,0,0,4" IsReadOnly="True"
                     Background="{StaticResource SoftPanelBrush}"
                     ToolTip="نام سازمان قفل است و قابل تغییر نیست"/>
            <TextBlock Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,12"
                       Text="نام سازمان قفل است و از این بخش قابل ویرایش نیست."/>
            <TextBlock Style="{StaticResource FieldLabel}" Text="مهلت نشست به دقیقه"/>
            <TextBox x:Name="SessionBox" Style="{StaticResource LtrBox}" Margin="0,0,0,12"/>
            <TextBlock Style="{StaticResource FieldLabel}" Text="قفل خودکار به دقیقه"/>
            <TextBox x:Name="LockBox" Style="{StaticResource LtrBox}" Margin="0,0,0,12"/>
            <Button Content="ذخیره تنظیمات عمومی" Style="{StaticResource PrimaryButton}" Click="OnSaveGeneral"
                    HorizontalAlignment="Stretch" Margin="0,0,0,0"/>
            <Button Content="تغییر رمز عبور من" Style="{StaticResource GhostButton}" Click="OnPassword"
                    HorizontalAlignment="Stretch" Margin="0,12,0,16"/>
            <TextBlock Text="مسیر داده" FontWeight="SemiBold"/>
            <TextBlock x:Name="DataPath" Style="{StaticResource PathText}" Margin="0,6,0,8"/>
            <TextBlock Text="پوشه نصب" FontWeight="SemiBold"/>
            <TextBlock x:Name="InstallPath" Style="{StaticResource PathText}"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem x:Name="BackupTab" Header="پشتیبان">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="16,12" MaxWidth="640" HorizontalAlignment="Stretch">
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,14" Style="{StaticResource MutedText}"
                       Text="فایل پشتیبان شامل پایگاه داده، تنظیمات، کاربران، پرسنل، اسناد، عکس‌ها و کلیدهای رمز است و با همان رمز روی سیستم دیگر بازیابی می‌شود."/>

            <Border Style="{StaticResource SoftPanel}" Margin="0,0,0,14" Padding="16">
              <StackPanel>
                <TextBlock Text="ساخت پشتیبان" FontWeight="SemiBold" FontSize="15"
                           Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,6"/>
                <TextBlock Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"
                           Text="یک رمز حداقل ۶ کاراکتری انتخاب کنید و فایل را در مسیر امن ذخیره کنید."/>
                <TextBlock Style="{StaticResource FieldLabel}" Text="رمز پشتیبان"/>
                <PasswordBox x:Name="BackupPassBox" Margin="0,0,0,10"/>
                <TextBlock Style="{StaticResource FieldLabel}" Text="تکرار رمز"/>
                <PasswordBox x:Name="BackupPass2Box" Margin="0,0,0,14"/>
                <Button Content="ساخت و ذخیره فایل پشتیبان" Style="{StaticResource PrimaryButton}"
                        Click="OnBackup" HorizontalAlignment="Stretch"/>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource SoftPanel}" Margin="0,0,0,14" Padding="16">
              <StackPanel>
                <TextBlock Text="بازیابی از فایل" FontWeight="SemiBold" FontSize="15"
                           Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,6"/>
                <TextBlock Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"
                           Text="دادهٔ فعلی با محتوای فایل پشتیبان جایگزین می‌شود. قبل از بازیابی از صحت فایل و رمز مطمئن شوید."/>
                <TextBlock Style="{StaticResource FieldLabel}" Text="رمز فایل پشتیبان"/>
                <PasswordBox x:Name="RestorePassBox" Margin="0,0,0,14"/>
                <Button Content="انتخاب فایل و بازیابی" Style="{StaticResource GhostButton}"
                        Click="OnRestore" HorizontalAlignment="Stretch"/>
              </StackPanel>
            </Border>

            <TextBlock x:Name="BackupStatusText" TextWrapping="Wrap" Margin="0,0,0,14"
                       MinHeight="20" Foreground="{StaticResource OnSurfaceBrush}"/>

            <Border BorderBrush="{StaticResource DangerBrush}" BorderThickness="1" CornerRadius="10"
                    Background="#14C62828" Padding="14" Margin="0,0,0,8">
              <StackPanel>
                <TextBlock Text="منطقه خطر" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" Margin="0,0,0,8"/>
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" Foreground="{StaticResource OnSurfaceBrush}"
                           Text="پاک کردن همه داده‌های برنامه (پرسنل، اسناد، کاربران، تنظیمات و …). فقط با تأیید سخت و رمز حساب انجام می‌شود."/>
                <Button Content="پاک کردن همه داده‌های برنامه…" Style="{StaticResource DangerButton}"
                        Click="OnWipeAll" HorizontalAlignment="Stretch"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem x:Name="UsersTab" Header="کاربران">
        <DockPanel Margin="12">
          <Border DockPanel.Dock="Left" Width="300" Style="{StaticResource Card}" Margin="0,0,12,0"
                  VerticalAlignment="Stretch" HorizontalAlignment="Left">
            <StackPanel>
              <TextBlock Text="کاربر جدید" FontWeight="Bold" Margin="0,0,0,10" Foreground="{StaticResource PrimaryBrush}"/>
              <TextBlock Style="{StaticResource FieldLabel}" Text="نام کاربری"/>
              <TextBox x:Name="UserBox" Style="{StaticResource LtrBox}" Margin="0,0,0,8"/>
              <TextBlock Style="{StaticResource FieldLabel}" Text="نام نمایشی"/>
              <TextBox x:Name="NameBox" Margin="0,0,0,8"/>
              <TextBlock Style="{StaticResource FieldLabel}" Text="رمز موقت"/>
              <PasswordBox x:Name="PassBox" Margin="0,0,0,8"/>
              <TextBlock Style="{StaticResource FieldLabel}" Text="نقش"/>
              <ComboBox x:Name="RoleBox" DisplayMemberPath="Value" SelectedValuePath="Key" Margin="0,0,0,10"/>
              <Button Content="ایجاد" Style="{StaticResource PrimaryButton}" Click="OnCreateUser"
                      HorizontalAlignment="Stretch" Margin="0,0,0,0"/>
              <Button Content="بازنشانی رمز انتخاب‌شده" Style="{StaticResource GhostButton}" Click="OnResetUser"
                      HorizontalAlignment="Stretch" Margin="0,12,0,0"/>
              <Button Content="فعال/غیرفعال" Style="{StaticResource GhostButton}" Click="OnToggleUser"
                      HorizontalAlignment="Stretch" Margin="0,10,0,0"/>
            </StackPanel>
          </Border>
          <DataGrid x:Name="UsersGrid" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
              <DataGridTextColumn Header="نام کاربری" Binding="{Binding Username}" Width="*"/>
              <DataGridTextColumn Header="نام" Binding="{Binding DisplayName}" Width="*"/>
              <DataGridTextColumn Header="نقش" Binding="{Binding RoleNameFa}" Width="*"/>
              <DataGridCheckBoxColumn Header="فعال" Binding="{Binding IsActive}" Width="70"
                                      ElementStyle="{StaticResource GridCheckBox}"
                                      EditingElementStyle="{StaticResource GridCheckBox}"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>

      <TabItem x:Name="AuditTab" Header="log">
        <DockPanel Margin="12">
          <Border DockPanel.Dock="Top" Style="{StaticResource CardFill}" Padding="12" Margin="0,0,0,10">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Style="{StaticResource FieldLabel}" Text="جستجو در log"/>
                <TextBox x:Name="AuditSearchBox" ToolTip="جستجو در کاربر، عملیات، نوع یا جزئیات"/>
              </StackPanel>
              <TextBlock x:Name="AuditCountText" Grid.Column="2" Style="{StaticResource MutedText}"
                         VerticalAlignment="Bottom" Margin="0,0,0,8"/>
              <Button Grid.Column="4" Content="بروزرسانی" Style="{StaticResource GhostButton}"
                      VerticalAlignment="Bottom" Click="OnRefreshAudit" MinHeight="34" Padding="14,6"/>
            </Grid>
          </Border>
          <DataGrid x:Name="AuditGrid" AutoGenerateColumns="False" IsReadOnly="True"
                    HeadersVisibility="Column" CanUserAddRows="False" CanUserResizeRows="False"
                    AlternatingRowBackground="{StaticResource SoftPanelBrush}"
                    RowHeight="36" ColumnHeaderHeight="40">
            <DataGrid.ColumnHeaderStyle>
              <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.CellStyle>
              <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Padding" Value="8,4"/>
                <Setter Property="TextBlock.TextAlignment" Value="Center"/>
              </Style>
            </DataGrid.CellStyle>
            <DataGrid.Columns>
              <DataGridTextColumn Header="تاریخ و ساعت" Binding="{Binding CreatedDateTimeFa}" Width="170"/>
              <DataGridTextColumn Header="کاربر" Binding="{Binding ActorUsername}" Width="110"/>
              <DataGridTextColumn Header="عملیات" Binding="{Binding ActionFa}" Width="140"/>
              <DataGridTextColumn Header="بخش" Binding="{Binding EntityTypeFa}" Width="110"/>
              <DataGridTextColumn Header="جزئیات" Binding="{Binding DetailsFa}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</Page>
