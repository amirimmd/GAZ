<Window x:Class="Qaemshahr.App.Views.WipeDataWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="پاک کردن همه داده‌ها"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Language="fa-IR"
        FlowDirection="LeftToRight"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource AppFont}"
        Icon="/Qaemshahr;component/Assets/app.ico">
  <DockPanel FlowDirection="RightToLeft" Margin="22,18">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,18,0,0">
      <Button Content="انصراف" Style="{StaticResource GhostButton}" IsCancel="True" Click="OnCancel" MinWidth="110"/>
      <Button x:Name="WipeButton" Content="پاک کردن قطعی همه داده‌ها" Style="{StaticResource DangerButton}"
              Click="OnWipe" MinWidth="180" IsEnabled="False"/>
    </StackPanel>

    <StackPanel>
      <TextBlock Text="هشدار جدی — برگشت‌ناپذیر" FontSize="18" FontWeight="Bold"
                 Foreground="{StaticResource DangerBrush}" Margin="0,0,0,10"/>
      <Border Background="#FFF8E8E8" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1"
              CornerRadius="8" Padding="12" Margin="0,0,0,14">
        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource OnSurfaceBrush}" LineHeight="22"
                   Text="با این کار تمام پرسنل، اسناد، عکس‌ها، ارزیابی‌ها، کاربران، تنظیمات، کلیدهای رمز و پشتیبان‌های داخلی برنامه برای همیشه پاک می‌شوند. این عمل قابل بازگشت نیست مگر اینکه از قبل فایل پشتیبان جداگانه گرفته باشید."/>
      </Border>

      <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,6" TextWrapping="Wrap"
                 Text="برای تأیید، دقیقاً این عبارت را تایپ کنید:"/>
      <TextBlock FontWeight="SemiBold" Margin="0,0,0,6" Text="پاک کردن همه"
                 Foreground="{StaticResource DangerBrush}"/>
      <TextBox x:Name="PhraseBox" FlowDirection="RightToLeft" TextAlignment="Right"
               TextChanged="OnFormChanged"/>

      <TextBlock Style="{StaticResource FieldLabel}" Text="رمز ورود حساب فعلی" Margin="0,14,0,6"/>
      <PasswordBox x:Name="PassBox" PasswordChanged="OnPassChanged"/>

      <CheckBox x:Name="UnderstandBox" Margin="0,14,0,0"
                Content="متوجه هستم که همه داده‌ها برای همیشه حذف می‌شوند"
                Checked="OnFormChanged" Unchecked="OnFormChanged"/>

      <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                 Margin="0,12,0,0" MinHeight="20"/>
    </StackPanel>
  </DockPanel>
</Window>
