<Window x:Class="Qaemshahr.App.Views.SampleReportsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="گزارش‌های نمونه"
        Width="520" Height="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Language="fa-IR"
        FlowDirection="LeftToRight"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource AppFont}">
  <DockPanel Margin="16" FlowDirection="RightToLeft">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <TextBlock x:Name="TitleText" Style="{StaticResource PageTitle}" TextWrapping="Wrap"/>
      <TextBlock x:Name="SubText" Style="{StaticResource MutedText}" Margin="0,4,0,0" TextWrapping="Wrap"/>
    </StackPanel>

    <Border DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <StackPanel>
        <TextBlock Style="{StaticResource FieldLabel}" Text="گزارش جدید"/>
        <TextBox x:Name="BodyBox" MinHeight="72" AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" Margin="0,0,0,8"/>
        <DockPanel LastChildFill="False">
          <Button DockPanel.Dock="Left" Content="بستن" Style="{StaticResource GhostButton}"
                  Click="OnClose" MinWidth="90" Padding="14,6"/>
          <Button DockPanel.Dock="Right" Content="ثبت گزارش" Style="{StaticResource PrimaryButton}"
                  Click="OnAdd" MinWidth="110" Padding="14,6"/>
        </DockPanel>
      </StackPanel>
    </Border>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel x:Name="ListHost"/>
    </ScrollViewer>
  </DockPanel>
</Window>
