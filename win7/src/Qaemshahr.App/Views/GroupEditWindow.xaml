<Window x:Class="Qaemshahr.App.Views.GroupEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:Qaemshahr.App.Controls"
        Title="گروه" Height="760" Width="980" MinHeight="640" MinWidth="860"
        WindowStartupLocation="CenterOwner" FlowDirection="LeftToRight"
        Background="{StaticResource BgBrush}" FontFamily="{StaticResource AppFont}">
  <Window.Resources>
    <Style x:Key="FilterCheck" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
      <Setter Property="Margin" Value="0,0,14,4"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style x:Key="CenterCellText" TargetType="TextBlock">
      <Setter Property="TextAlignment" Value="Center"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="TextWrapping" Value="NoWrap"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
  </Window.Resources>

  <DockPanel Margin="16" FlowDirection="RightToLeft">
    <StackPanel DockPanel.Dock="Bottom" Style="{StaticResource DialogButtonBar}" Margin="0,12,0,0">
      <Button Content="انصراف" Style="{StaticResource GhostButton}" IsCancel="True" Click="OnCancel"/>
      <Button Content="ذخیره" Style="{StaticResource PrimaryButton}" Click="OnSave"/>
    </StackPanel>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- مشخصات گروه -->
      <Border Grid.Row="0" Style="{StaticResource CardFill}" Padding="12" Margin="0,0,0,10">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <StackPanel Width="120" VerticalAlignment="Top">
            <Border Width="108" Height="108" CornerRadius="12"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    Background="{StaticResource SoftPanelBrush}" ClipToBounds="True">
              <Grid>
                <TextBlock x:Name="PhotoPlaceholder" Text="عکس گروه"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                <Image x:Name="PhotoImage" Stretch="UniformToFill"/>
              </Grid>
            </Border>
            <WrapPanel Margin="0,8,0,0" HorizontalAlignment="Center">
              <Button Content="انتخاب" Style="{StaticResource ChipButton}" Click="OnPickPhoto"
                      MinHeight="30" Padding="10,4" Margin="0,0,6,0"/>
              <Button Content="حذف" Style="{StaticResource GhostButton}" Click="OnClearPhoto"
                      MinHeight="30" Padding="10,4"/>
            </WrapPanel>
          </StackPanel>

          <Grid Grid.Column="2">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="12"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="12"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
              <TextBlock Style="{StaticResource FieldLabel}" Text="نام گروه"/>
              <TextBox x:Name="NameBox"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Style="{StaticResource FieldLabel}" Text="نوع"/>
              <ComboBox x:Name="PurposeBox" SelectionChanged="OnPurposeChanged">
                <ComboBoxItem Content="مأموریت" Tag="mission"/>
                <ComboBoxItem Content="آموزش" Tag="training"/>
                <ComboBoxItem Content="کمیته" Tag="committee"/>
                <ComboBoxItem Content="پروژه" Tag="project"/>
                <ComboBoxItem Content="سایر" Tag="other" IsSelected="True"/>
              </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="4" x:Name="PurposeOtherPanel" Visibility="Visible">
              <TextBlock Style="{StaticResource FieldLabel}" Text="نوع سفارشی (سایر)"/>
              <ComboBox x:Name="PurposeOtherBox" IsEditable="True" IsTextSearchEnabled="True"
                        StaysOpenOnEdit="True"
                        ToolTip="بنویسید؛ برای دفعه بعد ذخیره می‌شود. راست‌کلیک روی پیشنهاد = حذف"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5" Margin="0,10,0,0">
              <TextBlock Style="{StaticResource FieldLabel}" Text="توضیح"/>
              <TextBox x:Name="DescBox"/>
            </StackPanel>

            <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5" Margin="0,10,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Style="{StaticResource FieldLabel}" Text="تاریخ شروع"/>
                <ctrl:ShamsiDateField x:Name="StartDateBox"/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Style="{StaticResource FieldLabel}" Text="تاریخ پایان"/>
                <ctrl:ShamsiDateField x:Name="EndDateBox"/>
              </StackPanel>
              <StackPanel Grid.Column="4">
                <TextBlock Style="{StaticResource FieldLabel}" Text="وضعیت"/>
                <ComboBox x:Name="StatusBox">
                  <ComboBoxItem Content="فعال" Tag="active" IsSelected="True"/>
                  <ComboBoxItem Content="بایگانی" Tag="archived"/>
                </ComboBox>
              </StackPanel>
            </Grid>
          </Grid>
        </Grid>
      </Border>

      <!-- فیلتر اعضا -->
      <Border Grid.Row="1" Style="{StaticResource CardFill}" Padding="12" Margin="0,0,0,10">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Style="{StaticResource FieldLabel}" Text="جستجو (نام / کد ملی / شماره پرسنلی / سمت)"/>
            <TextBox x:Name="SearchBox"/>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Style="{StaticResource FieldLabel}" Text="وضعیت پرسنل"/>
            <WrapPanel Margin="0,4,0,0">
              <CheckBox x:Name="StatusActiveBox" Content="فعال" Style="{StaticResource FilterCheck}" IsChecked="True"
                        Checked="OnMemberFilterChanged" Unchecked="OnMemberFilterChanged"/>
              <CheckBox x:Name="StatusInactiveBox" Content="غیرفعال" Style="{StaticResource FilterCheck}" IsChecked="True"
                        Checked="OnMemberFilterChanged" Unchecked="OnMemberFilterChanged"/>
            </WrapPanel>
          </StackPanel>
          <StackPanel Grid.Column="4">
            <TextBlock Style="{StaticResource FieldLabel}" Text="نوع پرسنل"/>
            <WrapPanel Margin="0,4,0,0">
              <CheckBox x:Name="PersonEmployeeBox" Content="کارمند" Style="{StaticResource FilterCheck}"
                        Checked="OnMemberFilterChanged" Unchecked="OnMemberFilterChanged"/>
              <CheckBox x:Name="PersonWorkerBox" Content="کارگر" Style="{StaticResource FilterCheck}"
                        Checked="OnMemberFilterChanged" Unchecked="OnMemberFilterChanged"/>
            </WrapPanel>
          </StackPanel>
          <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Bottom">
            <Button Content="انتخاب همهٔ فیلتر" Style="{StaticResource ChipButton}" Click="OnSelectFiltered"
                    MinHeight="34" Margin="0,0,8,0"/>
            <Button Content="برداشتن تیک‌ها" Style="{StaticResource ChipButton}" Click="OnClearSelection"
                    MinHeight="34" Margin="0"/>
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="2" Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="MemberCountText" Style="{StaticResource MutedText}" VerticalAlignment="Center"
                   Text="اعضای گروه"/>
        <TextBlock x:Name="SelectedCountText" Grid.Column="1" Style="{StaticResource MutedText}"
                   VerticalAlignment="Center"/>
      </Grid>

      <DataGrid x:Name="MembersGrid" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True"
                HeadersVisibility="Column" CanUserAddRows="False" CanUserResizeRows="False"
                SelectionMode="Single" SelectionUnit="FullRow"
                AlternatingRowBackground="{StaticResource SoftPanelBrush}"
                RowHeight="36" ColumnHeaderHeight="40"
                EnableRowVirtualization="True"
                HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <DataGrid.ColumnHeaderStyle>
          <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
          </Style>
        </DataGrid.ColumnHeaderStyle>
        <DataGrid.CellStyle>
          <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="TextBlock.TextAlignment" Value="Center"/>
          </Style>
        </DataGrid.CellStyle>
        <DataGrid.Columns>
          <DataGridTemplateColumn Header="انتخاب" Width="70" CanUserResize="False">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                          Style="{StaticResource GridCheckBox}"
                          IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          Checked="OnRowCheckChanged" Unchecked="OnRowCheckChanged"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="نام" Binding="{Binding FullName}" Width="1.4*" MinWidth="140">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCellText}"/>
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTextColumn Header="کد ملی" Binding="{Binding NationalId}" Width="110">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCellText}"/>
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTextColumn Header="شماره پرسنلی" Binding="{Binding EmployeeNumber}" Width="110">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCellText}"/>
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTextColumn Header="سمت" Binding="{Binding CurrentPosition}" Width="1.2*" MinWidth="100">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCellText}"/>
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTextColumn Header="نوع استخدام" Binding="{Binding EmploymentType}" Width="110">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCellText}"/>
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTextColumn Header="نوع پرسنل" Binding="{Binding PersonTypeFa}" Width="90">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCellText}"/>
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTextColumn Header="وضعیت" Binding="{Binding StatusFa}" Width="80">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCellText}"/>
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
        </DataGrid.Columns>
      </DataGrid>
    </Grid>
  </DockPanel>
</Window>
