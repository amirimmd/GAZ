<Window x:Class="Qaemshahr.App.Views.WorkerProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="پروژه اجرایی" Height="560" Width="480"
        WindowStartupLocation="CenterOwner" Language="fa-IR" FlowDirection="LeftToRight"
        Background="{StaticResource BgBrush}" FontFamily="{StaticResource AppFont}" ResizeMode="NoResize">
  <DockPanel FlowDirection="RightToLeft">
    <Border DockPanel.Dock="Bottom" Padding="16" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
      <StackPanel Style="{StaticResource DialogButtonBar}">
        <Button Content="انصراف" Style="{StaticResource GhostButton}" Click="OnCancel" IsCancel="True"/>
        <Button Content="ثبت" Style="{StaticResource PrimaryButton}" Click="OnOk" IsDefault="True"/>
      </StackPanel>
    </Border>
    <ScrollViewer>
      <StackPanel Margin="20">
        <TextBlock Style="{StaticResource FieldLabel}" Text="عنوان پروژه *"/>
        <TextBox x:Name="TitleBox" Margin="0,0,0,14"/>

        <TextBlock Style="{StaticResource FieldLabel}" Text="سطح پروژه (۱ تا ۱۰)"/>
        <ComboBox x:Name="LevelBox" Margin="0,0,0,14"/>

        <TextBlock Style="{StaticResource FieldLabel}" Text="ساعت فعالیت این فرد روی پروژه"/>
        <TextBox x:Name="HoursBox" Style="{StaticResource LtrBox}" Margin="0,0,0,8"/>
        <WrapPanel Margin="0,0,0,14">
          <Button Content="+۴" Style="{StaticResource ChipButton}" Click="OnAddHours" Tag="4"/>
          <Button Content="+۸" Style="{StaticResource ChipButton}" Click="OnAddHours" Tag="8"/>
          <Button Content="+۱۶" Style="{StaticResource ChipButton}" Click="OnAddHours" Tag="16"/>
          <Button Content="+۴۰" Style="{StaticResource ChipButton}" Click="OnAddHours" Tag="40"/>
        </WrapPanel>

        <TextBlock Style="{StaticResource FieldLabel}" Text="پیشرفت کلی پروژه (٪)"/>
        <TextBox x:Name="ProgressBox" Style="{StaticResource LtrBox}" Margin="0,0,0,8"/>
        <WrapPanel Margin="0,0,0,14">
          <Button Content="۲۵٪" Style="{StaticResource ChipButton}" Click="OnSetProgress" Tag="25"/>
          <Button Content="۵۰٪" Style="{StaticResource ChipButton}" Click="OnSetProgress" Tag="50"/>
          <Button Content="۷۵٪" Style="{StaticResource ChipButton}" Click="OnSetProgress" Tag="75"/>
          <Button Content="۱۰۰٪" Style="{StaticResource ChipButton}" Click="OnSetProgress" Tag="100"/>
        </WrapPanel>

        <TextBlock Style="{StaticResource FieldLabel}" Text="تعداد چک‌لیست با نقش این فرد"/>
        <TextBox x:Name="ChecklistBox" Style="{StaticResource LtrBox}" Margin="0,0,0,14"/>

        <UniformGrid Columns="2" Margin="0,0,0,14">
          <StackPanel Margin="0,0,8,0">
            <TextBlock Style="{StaticResource FieldLabel}" Text="حوادث مستقیم"/>
            <TextBox x:Name="DirectBox" Style="{StaticResource LtrBox}"/>
          </StackPanel>
          <StackPanel>
            <TextBlock Style="{StaticResource FieldLabel}" Text="حوادث غیرمستقیم"/>
            <TextBox x:Name="IndirectBox" Style="{StaticResource LtrBox}"/>
          </StackPanel>
        </UniformGrid>

        <CheckBox x:Name="SevereBox" Content="حادثه شدید / توقف کار (خط قرمز نمونه)"/>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
