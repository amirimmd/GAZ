<Window x:Class="Qaemshahr.App.Views.ExportColumnsWindow"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        Title="ستون‌های خروجی اکسل" Height="640" Width="720"

        WindowStartupLocation="CenterOwner" FlowDirection="LeftToRight"

        Background="{StaticResource BgBrush}" FontFamily="{StaticResource AppFont}">

  <DockPanel Margin="16" FlowDirection="RightToLeft">

    <StackPanel DockPanel.Dock="Bottom" Style="{StaticResource DialogButtonBar}" Margin="0,16,0,0">

      <Button Content="انصراف" Style="{StaticResource GhostButton}" IsCancel="True" Click="OnCancel"/>

      <Button Content="ادامه خروجی" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnOk"/>

    </StackPanel>

    <DockPanel>

      <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">

        <TextBlock Style="{StaticResource SectionTitle}" Text="انتخاب و اولویت ستون‌ها"/>

        <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,8"

                   Text="ستون‌های تیک‌خورده در خروجی می‌آیند. ترتیب لیست سمت چپ = اولویت ستون‌ها در فایل اکسل."/>

        <WrapPanel>

          <Button Content="همه" Style="{StaticResource ChipButton}" Click="OnAll"/>

          <Button Content="هیچ‌کدام" Style="{StaticResource ChipButton}" Click="OnNone"/>

          <Button Content="پیش‌فرض" Style="{StaticResource ChipButton}" Click="OnDefault"/>

        </WrapPanel>

      </StackPanel>

      <Grid>

        <Grid.ColumnDefinitions>

          <ColumnDefinition Width="1.1*"/>

          <ColumnDefinition Width="12"/>

          <ColumnDefinition Width="*"/>

        </Grid.ColumnDefinitions>

        <DockPanel>

          <TextBlock DockPanel.Dock="Top" Style="{StaticResource FieldLabel}" Text="همه ستون‌ها" Margin="0,0,0,6"/>

          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"

                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="8">

            <StackPanel x:Name="ColumnsHost"/>

          </ScrollViewer>

        </DockPanel>

        <DockPanel Grid.Column="2">

          <TextBlock DockPanel.Dock="Top" Style="{StaticResource FieldLabel}" Text="ترتیب خروجی" Margin="0,0,0,6"/>

          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0" HorizontalAlignment="Left">

            <Button Content="بالا ▲" Style="{StaticResource ChipButton}" Click="OnMoveUp" MinWidth="72"/>

            <Button Content="پایین ▼" Style="{StaticResource ChipButton}" Click="OnMoveDown" MinWidth="72"/>

          </StackPanel>

          <ListBox x:Name="OrderBox" DisplayMemberPath="TitleFa"

                   BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>

        </DockPanel>

      </Grid>

    </DockPanel>

  </DockPanel>

</Window>


