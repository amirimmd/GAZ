<Window x:Class="Qaemshahr.App.Views.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تغییر رمز عبور"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Language="fa-IR"
        FlowDirection="LeftToRight"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource AppFont}">
  <Border Margin="18" Background="{StaticResource SurfaceBrush}"
          BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
          CornerRadius="14" Padding="24,20" FlowDirection="RightToLeft">
    <StackPanel>
      <TextBlock Text="تغییر رمز عبور" Style="{StaticResource PageTitle}"
                 HorizontalAlignment="Center" TextAlignment="Center"/>
      <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,16" TextAlignment="Center" TextWrapping="Wrap"
                 Text="رمز جدید حداقل ۱۰ کاراکتر و شامل حرف بزرگ، حرف کوچک و عدد باشد."/>

      <TextBlock Style="{StaticResource FieldLabel}" Text="رمز عبور فعلی"/>
      <Grid FlowDirection="LeftToRight" Margin="0,0,0,12">
        <PasswordBox x:Name="CurrentBox" Padding="10,8,42,8"/>
        <TextBox x:Name="CurrentPlainBox" Style="{StaticResource LtrBox}" Padding="10,8,42,8" Visibility="Collapsed"/>
        <ToggleButton x:Name="CurrentEye" Width="34" Height="34" Margin="0,0,6,0"
                      HorizontalAlignment="Right" VerticalAlignment="Center"
                      Background="Transparent" BorderThickness="0" Cursor="Hand" Focusable="False"
                      ToolTip="نمایش / مخفی کردن رمز"
                      Checked="OnToggleCurrent" Unchecked="OnToggleCurrent">
          <Viewbox Width="18" Height="18">
            <Path x:Name="CurrentEyePath" Fill="{StaticResource MutedBrush}" Stretch="Uniform"
                  Data="M12,4.5C7,4.5 2.73,7.61 1,12C2.73,16.39 7,19.5 12,19.5C17,19.5 21.27,16.39 23,12C21.27,7.61 17,4.5 12,4.5M12,17A5,5 0 0,1 7,12A5,5 0 0,1 12,7A5,5 0 0,1 17,12A5,5 0 0,1 12,17M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9Z"/>
          </Viewbox>
        </ToggleButton>
      </Grid>

      <TextBlock Style="{StaticResource FieldLabel}" Text="رمز عبور جدید"/>
      <Grid FlowDirection="LeftToRight" Margin="0,0,0,12">
        <PasswordBox x:Name="NewBox" Padding="10,8,42,8"/>
        <TextBox x:Name="NewPlainBox" Style="{StaticResource LtrBox}" Padding="10,8,42,8" Visibility="Collapsed"/>
        <ToggleButton x:Name="NewEye" Width="34" Height="34" Margin="0,0,6,0"
                      HorizontalAlignment="Right" VerticalAlignment="Center"
                      Background="Transparent" BorderThickness="0" Cursor="Hand" Focusable="False"
                      ToolTip="نمایش / مخفی کردن رمز"
                      Checked="OnToggleNew" Unchecked="OnToggleNew">
          <Viewbox Width="18" Height="18">
            <Path x:Name="NewEyePath" Fill="{StaticResource MutedBrush}" Stretch="Uniform"
                  Data="M12,4.5C7,4.5 2.73,7.61 1,12C2.73,16.39 7,19.5 12,19.5C17,19.5 21.27,16.39 23,12C21.27,7.61 17,4.5 12,4.5M12,17A5,5 0 0,1 7,12A5,5 0 0,1 12,7A5,5 0 0,1 17,12A5,5 0 0,1 12,17M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9Z"/>
          </Viewbox>
        </ToggleButton>
      </Grid>

      <TextBlock Style="{StaticResource FieldLabel}" Text="تکرار رمز عبور جدید"/>
      <Grid FlowDirection="LeftToRight" Margin="0,0,0,8">
        <PasswordBox x:Name="ConfirmBox" Padding="10,8,42,8"/>
        <TextBox x:Name="ConfirmPlainBox" Style="{StaticResource LtrBox}" Padding="10,8,42,8" Visibility="Collapsed"/>
        <ToggleButton x:Name="ConfirmEye" Width="34" Height="34" Margin="0,0,6,0"
                      HorizontalAlignment="Right" VerticalAlignment="Center"
                      Background="Transparent" BorderThickness="0" Cursor="Hand" Focusable="False"
                      ToolTip="نمایش / مخفی کردن رمز"
                      Checked="OnToggleConfirm" Unchecked="OnToggleConfirm">
          <Viewbox Width="18" Height="18">
            <Path x:Name="ConfirmEyePath" Fill="{StaticResource MutedBrush}" Stretch="Uniform"
                  Data="M12,4.5C7,4.5 2.73,7.61 1,12C2.73,16.39 7,19.5 12,19.5C17,19.5 21.27,16.39 23,12C21.27,7.61 17,4.5 12,4.5M12,17A5,5 0 0,1 7,12A5,5 0 0,1 12,7A5,5 0 0,1 17,12A5,5 0 0,1 12,17M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9Z"/>
          </Viewbox>
        </ToggleButton>
      </Grid>

      <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                 Margin="0,8,0,8" MinHeight="18" TextAlignment="Center"/>
      <Button Content="ذخیره رمز جدید" Style="{StaticResource PrimaryButton}" Click="OnSave"
              HorizontalAlignment="Stretch" Margin="0,4,0,0"/>
    </StackPanel>
  </Border>
</Window>
